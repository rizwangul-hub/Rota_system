{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/src/assets/**",
          "backend/node_modules/pdfkit/js/standard-fonts/**",
          "backend/node_modules/pdfkit/js/data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/src/index.js"
    }
  ]
}
